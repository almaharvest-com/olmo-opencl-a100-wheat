+# ── Otsu thresholds on the probability histogram ──────────────────────────
+def _hist(v, nbins=256):
+    lo, hi = float(v.min()), float(v.max())
+    counts, edges = np.histogram(v, bins=nbins, range=(lo, hi))
+    centers = (edges[:-1] + edges[1:]) / 2
+    return counts.astype(np.float64), centers
+
+def otsu_2class(v, nbins=256):
+    """Otsu (1979): threshold maximising the between-class variance."""
+    c, x = _hist(v, nbins)
+    w0 = np.cumsum(c); w1 = w0[-1] - w0
+    m = np.cumsum(c * x)
+    mu0 = m / np.maximum(w0, 1e-12)
+    mu1 = (m[-1] - m) / np.maximum(w1, 1e-12)
+    var_b = w0 * w1 * (mu0 - mu1) ** 2
+    return float(x[int(np.argmax(var_b[:-1]))])
+
+def otsu_3class(v, nbins=256):
+    """Multi-level Otsu with three classes: two thresholds (t1 < t2)."""
+    c, x = _hist(v, nbins)
+    P = np.concatenate([[0.0], np.cumsum(c)])
+    S = np.concatenate([[0.0], np.cumsum(c * x)])
+    i = np.arange(1, nbins - 1)[:, None]      # class 1 = bins [0, i)
+    j = np.arange(2, nbins)[None, :]          # class 2 = [i, j), class 3 = [j, n)
+    ok = j > i
+    def term(a, b):
+        w = P[b] - P[a]; s = S[b] - S[a]
+        return np.where(w > 0, s * s / np.maximum(w, 1e-12), 0.0)
+    score = term(0, i) + term(i, j) + term(j, nbins)
+    score = np.where(ok, score, -np.inf)
+    a, b = np.unravel_index(int(np.argmax(score)), score.shape)
+    ii, jj = a + 1, b + 2
+    return float(x[ii - 1]), float(x[jj - 1])
+
